<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_input_intro"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:paddingBottom="16dp"/>
    <CheckBox
        android:id="@+id/voice_input_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_input_enabled_title"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/voice_input_api_key_title"/>
    <EditText
        android:id="@+id/voice_input_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/voice_input_api_key_hint"
        android:inputType="textPassword"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voice_input_model_title"/>
    <Spinner
        android:id="@+id/voice_input_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/voice_input_trigger_delay_title"/>
    <TextView
        android:id="@+id/voice_input_trigger_delay_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <SeekBar
        android:id="@+id/voice_input_trigger_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/voice_input_permission_title"/>
    <TextView
        android:id="@+id/voice_input_permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <Button
        android:id="@+id/voice_input_permission_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/voice_input_permission_button"/>
  </LinearLayout>
</ScrollView>
